  "api": {
    "k_select": "k_select(scores, k, dim=-1, sorted=True) -> int64 indices",
    "k_select_values": "k_select_values(scores, k, dim=-1, sorted=True) -> float scores",
    "reference_k_select": "reference_k_select(scores, k, dim=-1, sorted=True), two stable argsorts, any device"
  },
  "method": "one Metal kernel per call, in one of three forms.  Small k: a threadgroup per row, one lane per lane-strided slice, a per-lane top-k window in registers, then a shared-memory pairwise merge; a one-thread-per-row form of the same window takes over once there are enough rows to fill the device.  k >= 16: one simdgroup per row over 32-bit order keys \u2014 the k-th key found by histogramming 8 bits at a time, then the winners placed by rank, which keeps nothing per-k in registers.  k is a compile-time constant so buffers and the shift chain are sized to it. k > 256 or a non-MPS device takes the two-stable-argsort reference.",
  "import_is_inert": true,
  "limits": {
    "k": "the kernel covers k <= 256: the window forms to k = 15, the radix form from k = 16 up.  Above the kernel cutoff the two-argsort path runs, which is what the k-limit probe measured as the faster option there; the crossover is shape-dependent, so the probe reports it rather than a single number",
    "dtypes": "floating point only; on MPS float32/float16/bfloat16 reach the kernel, and integer or complex scores raise TypeError",
    "gradients": "k_select returns int64 with no graph; only k_select_values is differentiable, and it routes the gradient to the selected entries",
    "layout": "the selected axis may be any axis; a non-last axis costs one movedim copy, a non-contiguous or half input one more conversion",
    "compile": "the first call for a given (k, sorted) compiles a shader (15-45 ms measured on this machine), later calls hit the lru_cache; nothing compiles at import",
    "determinism": "the order is total, so the result is reproducible run to run and identical between the kernel and the sort path \u2014 unlike the bitonic selection in fla's NSA kernel, whose ties are arbitrary",
    "not_covered": "building NSA's block scores (per-head normalised scores summed over the group, the always-selected first and last blocks) and the block-sparse attention itself are the caller's"
  },
  "contract": {
    "scores": "larger first; equal scores by smaller index; NaN after every finite value",
    "sorted_false": "the same set, ascending by index (deterministic)",
    "output": "int64, scores.shape with k in place of dim",
    "kept": "0 <= k <= scores.shape[dim]; other values raise",
    "dtype": "float32/float16/bfloat16 on MPS run the kernel; half is widened to float32 first, which is exact, so the order is unchanged",
