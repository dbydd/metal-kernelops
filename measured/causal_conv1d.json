 "op": "causal_conv1d_fn / causal_conv1d_update (Dao-AILab/causal-conv1d semantics)",
 "api": {
  "causal_conv1d_fn": "x (B, C, L); weight (C, 1, K) or (C, K); bias (C,) or None; activation None|'silu'|'swish'; initial_state (B, C, K-1) or None; return_final_state -> out (B, C, L) [, final_state (B, C, K-1)]",
  "causal_conv1d_update": "x (B, C) or (B, C, q); state (B, C, s >= K-1) updated in place; weight (C, 1, K) or (C, K); bias (C,) or None; activation None|'silu'|'swish' -> out with the rank of x",
  "causal_conv1d_ref": "same contract as causal_conv1d_fn; explicit taps, no convolution, differentiable, any device and dtype"
 },
 "timing": {
  "clock": "time.perf_counter",
  "warmup": 5,
  "iterations": 30,
  "rounds": 9,
  "sync": "torch.mps.synchronize() after warmup and after each round",
  "statistic": "best round per call, rounds interleaved across the two functions",
  "baseline": "conv1d with an explicit causal pad (aten_forward / aten_update in the benchmark), which is what causal_conv1d_fn lowers to without the kernels",
  "traffic": {
   "forward": "read x, write out (2 tensors); the final state rides along",
   "backward": "read dout, read x, write dx (3 tensors), one fused pass for dx and dweight, with the pre-activation recomputed from x",
   "dweight_finalize": "the per-threadgroup partials of every batch row, folded",
   "floor": "a float4 copy moving the same byte count in the same batch"
  },
  "note": "shared machine, about 25 concurrent MPS jobs: each row is a minimum over interleaved rounds inside its own batch, so rows from different batches are not directly comparable and a busy batch inflates every number in it. The profile compares each stage with of_floor, a copy of the same traffic measured in the same batch, which survives the load."
 },
